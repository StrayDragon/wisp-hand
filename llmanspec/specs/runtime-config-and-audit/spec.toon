kind: llman.sdd.spec
name: "runtime-config-and-audit"
purpose: "定义运行时配置、结构化错误与审计日志的公共契约，确保所有 MCP 工具在同一治理边界内运行。"
valid_scope[1]: "llmanspec/specs/runtime-config-and-audit"
requirements[3]{req_id,title,statement}:
  r1,服务必须从统一配置源加载运行参数,"Wisp Hand 服务 MUST 从统一的运行时配置文件加载启动参数、目录约定、安全默认值与依赖探测选项，并在配置非法时给出明确诊断。"
  r2,所有工具失败都必须返回结构化错误,"所有 MCP tool 失败 MUST 返回稳定的结构化错误码与上下文数据，避免让客户端依赖字符串匹配来判断错误原因。"
  r3,所有工具调用都必须进入审计日志,"服务 MUST 为每次 tool call 记录文本日志与 JSONL 审计记录，至少包含时间戳、tool 名称、session、scope、执行结果、拒绝原因与延迟。"
scenarios[5]{req_id,id,given,when,then,feature}:
  r1,config-valid,"服务在启动时读取合法配置文件","配置值会覆盖默认值","进入后续 runtime 组件",false
  r1,config-invalid,"服务在启动时读取到缺失必填字段或类型错误的配置","服务 MUST 以明确的配置错误终止启动","不在运行中延迟失败",false
  r2,session-not-found,"客户端对不存在的 `session_id` 调用任何基础工具","服务返回 `session_not_found` 及相关上下文","不返回自由文本",false
  r2,capability-unavailable,"某个工具依赖的运行能力不可用","服务 MUST 返回 `capability_unavailable` 或 `dependency_missing`","附带具体原因",false
  r3,audit-success,"任意基础工具成功执行","服务写入一条包含结果与延迟的 JSONL 审计记录","",false
