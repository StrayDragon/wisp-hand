kind: llman.sdd.spec
name: "state-wait-and-diff"
purpose: "定义固定时长等待与 capture diff 的确定性观察契约，为上层 agent / client 提供稳定化与状态比较能力。"
valid_scope[1]: "llmanspec/specs/state-wait-and-diff"
requirements[2]{req_id,title,statement}:
  r1,服务必须支持固定时长等待,"Wisp Hand 服务 MUST 通过 `wisp_hand.wait` 提供固定时长等待能力，并允许 `wisp_hand.batch.run` 复用同一等待语义。"
  r2,服务必须支持 capture diff,"Wisp Hand 服务 MUST 通过 `wisp_hand.capture.diff` 基于两个 `capture_id` 做像素级差异比较，并返回 `changed`、`change_ratio` 与确定性 `summary`。"
scenarios[4]{req_id,id,given,when,then,feature}:
  r1,explicit-wait,"客户端调用 `wisp_hand.wait` 并提供 `duration_ms`","服务在等待指定时长后返回成功结果","",false
  r1,batch-wait,"客户端在 batch 中插入 `wait` 步骤","服务 MUST 按与 `wisp_hand.wait` 相同的语义执行等待","",false
  r2,diff-changed,"客户端对两张不同状态的截图调用 `wisp_hand.capture.diff`","服务返回 `changed=true`、正的 `change_ratio` 与可复现的差异摘要","",false
  r2,diff-missing-capture,"客户端调用 `wisp_hand.capture.diff` 但任一 `capture_id` 不存在","服务 MUST 返回结构化的 capture 查询错误","",false
